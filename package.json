{
  "name": "egodeath",
  "version": "1.0.0",
  "description": "JavaScript obfuscator",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "obfuscate": "node dist/index.js",
    "obfuscate-package": "ts-node --project tools/tsconfig.json tools/obfuscate-package.ts",
    "benchmark": "ts-node --project tools/tsconfig.json tools/benchmark.ts",
    "detect-obfuscation": "ts-node --project tools/tsconfig.json tools/obfuscation-detection-test.ts",
    "adversarial-test": "ts-node --project tools/tsconfig.json tools/adversarial-test.ts",
    "benchmark:transforms": "npm run build && node tools/benchmark-transforms.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "estraverse": "^5.3.0",
    "is-valid-var-name": "^1.0.2",
    "jsdom": "^30.1.0",
    "recast": "^0.24.0",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "@types/estraverse": "^5.1.7",
    "@types/estree": "^1.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "webcrack": "^2.16.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
}
